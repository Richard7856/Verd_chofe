# Proyecto Supabase "dash".
#
# Copiá este archivo a `.env` y completá los valores reales. La clave NO se
# versiona: este repositorio es público, y aunque la publishable key está
# pensada para ir en el cliente, no conviene dejarla indexada en GitHub.
#
# Los valores salen del panel de Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
